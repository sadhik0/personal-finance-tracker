# Copy this file to .env.local and fill in your own values.

# Your MongoDB connection string (MongoDB Atlas free tier works great).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finance-tracker
MONGODB_URI=your_mongodb_connection_string_here

# Invite code that friends must enter to register an account.
# If this is empty or missing, registration is CLOSED.
REGISTRATION_CODE=choose_a_long_random_code

NODE_ENV=development
